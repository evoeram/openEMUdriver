; openEMUdriver v2 — kernel driver (PortCLS), M4 render WaveRT.
;
; Binds the whole E-MU 0404 USB device to EmuUSBAudio.sys. The CA0189 firmware
; declares every audio interface as vendor-class 0xFF, so there is no usable
; usbccgp/MI_* split to bind against (see docs/RE_NOTES.md).
;
; SPDX-License-Identifier: LGPL-2.1-or-later

[Version]
Signature   = "$Windows NT$"
Class       = Media
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = openemu-ks.cat
DriverVer   = 11/08/2026,2.0.0.71
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
emuusbaudio.sys = 1

[Manufacturer]
%MfgName% = EmuKs,NTamd64

[EmuKs.NTamd64]
%Emu0404.DeviceDesc% = Emu0404.Install, USB\VID_041E&PID_3F04

;==============================================================
; E-MU 0404 USB
;==============================================================
[Emu0404.Install]
Include = ks.inf,wdmaudio.inf
Needs   = KS.Registration,WDMAUDIO.Registration
CopyFiles = EmuKs.CopyList
AddReg    = EmuKs.AddReg

[Emu0404.Install.HW]
AddReg = EmuKs.HwAddReg

[Emu0404.Install.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_WaveEmuRender%,EmuKs.Wave.Interface
AddInterface = %KSCATEGORY_RENDER%,%KSNAME_WaveEmuRender%,EmuKs.Wave.Interface
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_TopologyEmuRender%,EmuKs.Topology.Interface

[EmuKs.Wave.Interface]
AddReg = EmuKs.Wave.AddReg

[EmuKs.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%EmuKs.WaveName%

[EmuKs.Topology.Interface]
AddReg = EmuKs.Topology.AddReg

[EmuKs.Topology.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%EmuKs.TopologyName%

; The panel does not use a PDO audio interface: it opens the driver-owned
; \\.\EmuUSBAudioCtl control device instead (contract in Emu/emu_ioctl.h).

[Emu0404.Install.Services]
AddService = EmuUSBAudio,0x00000002,EmuKs.Service

[EmuKs.CopyList]
emuusbaudio.sys

[DestinationDirs]
DefaultDestDir  = 12
EmuKs.CopyList  = 12

[EmuKs.Service]
DisplayName   = %EmuKs.SvcDesc%
ServiceType   = 1                  ; SERVICE_KERNEL_DRIVER
StartType     = 3                  ; SERVICE_DEMAND_START
ErrorControl  = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\emuusbaudio.sys

[EmuKs.AddReg]
HKR,,Driver,,emuusbaudio.sys
HKR,,AssociatedFilters,,"wdmaud"
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%Emu0404.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%Emu0404.DeviceDesc%

[EmuKs.HwAddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; Match the stock usbaudio2/hdaudio audio-device ACL. Windows Audio runs as a
; service, not as the elevated client, and must be able to open the KS filter.
; The separate \\.\EmuUSBAudioCtl control device remains admin-only.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[Strings]
ProviderName    = "openEMUdriver project"
MfgName         = "openEMUdriver project"
DiskName        = "EmuUSBAudio Installation Disk"
Emu0404.DeviceDesc = "E-MU 0404 USB (openEMUdriver kernel)"
EmuKs.SvcDesc   = "EmuUSBAudio - openEMUdriver kernel transport"
Proxy.CLSID     = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO  = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSNAME_WaveEmuRender = "WaveEmuRender"
KSNAME_TopologyEmuRender = "TopologyEmuRender"
EmuKs.WaveName = "E-MU 0404 USB Render (openEMUdriver)"
EmuKs.TopologyName = "E-MU 0404 USB Topology (openEMUdriver)"
; The panel-visible control device name is \\.\EmuUSBAudioCtl (stage 4c); its
; class GUID lives in driver/emuusbaudio/Emu/emu_ioctl.h, which the panel
; compiles too.
