; openEMUdriver v2 — kernel driver (PortCLS), M1 test-INF.
;
; Binds the whole E-MU 0404 USB device to EmuUSBAudio.sys, which is the only
; PID this stage is approved for. Whole-device on purpose: the CA0189 firmware
; declares every audio interface as vendor-class 0xFF, so there is no usable
; usbccgp/MI_* split to bind against (see docs/RE_NOTES.md).
;
; M1 is a PnP skeleton: it registers no KS pins and creates no audio endpoints,
; so WDMAUDIO.Registration is deliberately absent until M4 adds WaveRT filters.
;
; SPDX-License-Identifier: LGPL-2.1-or-later

[Version]
Signature   = "$Windows NT$"
Class       = Media
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = openemu-ks.cat
DriverVer   = 11/04/2026,2.0.0.16
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
emuusbaudio.sys = 1

[Manufacturer]
%MfgName% = EmuKs,NTamd64

[EmuKs.NTamd64]
%Emu0404.DeviceDesc% = Emu0404.Install, USB\VID_041E&PID_3F04

;==============================================================
; E-MU 0404 USB
;==============================================================
[Emu0404.Install]
Include = ks.inf
Needs   = KS.Registration
CopyFiles = EmuKs.CopyList
AddReg    = EmuKs.AddReg

[Emu0404.Install.HW]
AddReg = EmuKs.HwAddReg

; No [Install.Interfaces] since stage 4c: the hardware run proved KS/PortCls
; rejects IRP_MJ_CREATE on the adapter FDO, so a PDO-registered interface can
; never be opened. The panel opens the driver-owned control device
; \\.\EmuUSBAudioCtl instead (created in DriverEntry, admin-only); the IOCTL
; contract lives in driver/emuusbaudio/Emu/emu_ioctl.h.

[Emu0404.Install.Services]
AddService = EmuUSBAudio,0x00000002,EmuKs.Service

[EmuKs.CopyList]
emuusbaudio.sys

[DestinationDirs]
DefaultDestDir  = 12
EmuKs.CopyList  = 12

[EmuKs.Service]
DisplayName   = %EmuKs.SvcDesc%
ServiceType   = 1                  ; SERVICE_KERNEL_DRIVER
StartType     = 3                  ; SERVICE_DEMAND_START
ErrorControl  = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\emuusbaudio.sys

[EmuKs.AddReg]
HKR,,Driver,,emuusbaudio.sys
; No AssociatedFilters on purpose: wdmaud/swmidi/redbook attach to the FDO and
; look for KS filters, and M1 registers none (no PcRegisterSubdevice), so their
; presence would mix other drivers' failures into the PnP soak. They come back
; in M4 together with WDMAUDIO.Registration.

[EmuKs.HwAddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; SDDL_DEVOBJ_SYS_ALL_ADM_ALL
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)"

[Strings]
ProviderName    = "openEMUdriver project"
MfgName         = "openEMUdriver project"
DiskName        = "EmuUSBAudio Installation Disk"
Emu0404.DeviceDesc = "E-MU 0404 USB (openEMUdriver kernel)"
EmuKs.SvcDesc   = "EmuUSBAudio - openEMUdriver kernel transport"
; The panel-visible control device name is \\.\EmuUSBAudioCtl (stage 4c); its
; class GUID lives in driver/emuusbaudio/Emu/emu_ioctl.h, which the panel
; compiles too.
